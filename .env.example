# ─── Server ───────────────────────────────────────────────────────────────────
PORT=8080
GIN_MODE=debug          # debug | release

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USER=anime_user
DB_PASSWORD=anime_password
DB_NAME=anime_platform
DB_SSLMODE=disable

# Full connection string (built from above in code)
# DB_URL=postgres://anime_user:anime_password@localhost:5432/anime_platform?sslmode=disable

# ─── JWT (for future auth) ────────────────────────────────────────────────────
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRY_HOURS=72

# ─── Frontend ─────────────────────────────────────────────────────────────────
VITE_API_URL=http://localhost:8080/api/v1
